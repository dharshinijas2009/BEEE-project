def lighten(hex_color, amt=0.22):
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    r, g, b = (int(c + (255 - c) * amt) for c in (r, g, b))
    return f"#{r:02x}{g:02x}{b:02x}"


def make_button(parent, text, command, bg, fg="white", size=13, padx=26, pady=10):
    """Label-based button (looks the same on Windows / Mac / Linux)."""
    b = tk.Label(parent, text=text, bg=bg, fg=fg, font=(FONT, size, "bold"),
                 padx=padx, pady=pady, cursor="hand2")
    hover = lighten(bg)
    b.bind("<Button-1>", lambda e: command())
    b.bind("<Enter>", lambda e: b.config(bg=hover))
    b.bind("<Leave>", lambda e: b.config(bg=bg))
    return b


def make_entry(parent, color, width=12):
    return tk.Entry(parent, font=(FONT, 14), width=width, justify="center", bg=BG, fg="white",
                    insertbackground="white", relief="flat", highlightthickness=2,
                    highlightbackground="#334155", highlightcolor=color)


def nature(phi):
    if abs(phi) < 1:
        return "Resistive"
    return "Inductive" if phi > 0 else "Capacitive"


def rating(pf):
    if pf >= 0.95:
        return "Excellent"
    if pf >= 0.80:
        return "Good"
    if pf >= 0.50:
        return "Average"
    return "Poor"


# ---------------------------------------------------------------- circuit model
class Circuit:
    def __init__(self):
        self.V, self.R, self.L, self.C, self.kind = 10.0, 100.0, 10e-3, 10e-6, "Series"

    @property
    def f0(self):
        return 1 / (2 * math.pi * math.sqrt(self.L * self.C))

    @property
    def Q(self):
        if self.kind == "Series":
            return math.sqrt(self.L / self.C) / self.R
        return self.R * math.sqrt(self.C / self.L)

    def metrics(self, f, kind=None):
        kind = kind or self.kind
        f = np.asarray(f, dtype=float)
        w = 2 * np.pi * f
        XL, XC = w * self.L, 1 / (w * self.C)
        if kind == "Series":
            Z = self.R + 1j * (XL - XC)
        else:  # parallel R || L || C
            Y = 1 / self.R + 1j * (w * self.C - 1 / XL)
            Z = 1 / Y
        mag, phi = np.abs(Z), np.angle(Z)
        I = self.V / mag
        return {"f": f, "Z": mag, "I": I, "phi": np.degrees(phi), "pf": np.cos(phi),
                "XL": XL, "XC": XC, "VR": I * self.R, "VL": I * XL, "VC": I * XC,
                "IR": self.V / self.R + 0 * f, "IL": self.V / XL, "IC": self.V / XC}


BOTH, SER, PAR = ("Series", "Parallel"), ("Series",), ("Parallel",)
# every quantity the user can put on the X or Y axis of the Graph Analysis page
PARAMS = {
    "Frequency (Hz)": dict(fn=lambda m: m["f"], unit="Hz", kinds=BOTH),
    "Current (mA)": dict(fn=lambda m: m["I"] * 1000, unit="mA", kinds=BOTH),
    "Impedance (Ω)": dict(fn=lambda m: m["Z"], unit="Ω", kinds=BOTH),
    "Phase angle (°)": dict(fn=lambda m: m["phi"], unit="°", kinds=BOTH),
    "Power factor": dict(fn=lambda m: m["pf"], unit="", kinds=BOTH),
    "Inductive reactance XL (Ω)": dict(fn=lambda m: m["XL"], unit="Ω", kinds=BOTH),
    "Capacitive reactance XC (Ω)": dict(fn=lambda m: m["XC"], unit="Ω", kinds=BOTH),
    "Voltage across R (V)": dict(fn=lambda m: m["VR"], unit="V", kinds=SER),
    "Voltage across L (V)": dict(fn=lambda m: m["VL"], unit="V", kinds=SER),
    "Voltage across C (V)": dict(fn=lambda m: m["VC"], unit="V", kinds=SER),
    "Resistor current IR (mA)": dict(fn=lambda m: m["IR"] * 1000, unit="mA", kinds=PAR),
    "Inductor current IL (mA)": dict(fn=lambda m: m["IL"] * 1000, unit="mA", kinds=PAR),
    "Capacitor current IC (mA)": dict(fn=lambda m: m["IC"] * 1000, unit="mA", kinds=PAR),
}


# ---------------------------------------------------------------- pages
class WelcomePage(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=BG)
        self.app = app
        self.cv = tk.Canvas(self, bg=BG, highlightthickness=0)
        self.cv.pack(fill="both", expand=True)
        self.btn = make_button(self.cv, "Start Simulation  →", lambda: app.show("setup"),
                               CYAN, fg=BG, size=18, padx=40, pady=14)
        self.cv.bind("<Configure>", self.draw)

    def draw(self, e):
        cv, w, h = self.cv, e.width, e.height
        cv.delete("all")
        c1, c2, steps = (11, 16, 32), (60, 20, 100), 60
        for i in range(steps):
            t = i / steps
            col = "#%02x%02x%02x" % tuple(int(c1[k] + (c2[k] - c1[k]) * t) for k in range(3))
            cv.create_rectangle(0, h * i / steps, w, h * (i + 1) / steps + 1, fill=col, outline=col)
        for amp, col, ph in ((55, CYAN, 0), (38, PINK, 1.6), (24, AMBER, 3.2)):
            pts = []
            for x in range(0, w + 1, 6):
                pts += [x, h * 0.82 + amp * math.sin(x / 70 + ph)]
            cv.create_line(*pts, fill=col, width=3, smooth=True)
        cv.create_text(w / 2, h * 0.20, text="RLC CIRCUIT", font=(FONT, 52, "bold"), fill=CYAN)
        cv.create_text(w / 2, h * 0.20 + 70, text="FREQUENCY  RESPONSE  SIMULATOR",
                       font=(FONT, 24, "bold"), fill="white")
        cv.create_text(w / 2, h * 0.20 + 115, text="Explore Current  •  Impedance  •  Phase Angle  •  Resonance",
                       font=(FONT, 14), fill=AMBER)
        cv.create_window(w / 2, h * 0.58, window=self.btn)


class SetupPage(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=BG)
        self.app = app
