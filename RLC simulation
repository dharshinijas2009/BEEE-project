        tk.Label(self, text="Enter the component values of your RLC circuit",
                 font=(FONT, 13), bg=BG, fg=MUTED).pack()
        card = tk.Frame(self, bg=CARD, padx=40, pady=26, highlightthickness=2, highlightbackground=VIOLET)
        card.pack(pady=22)
        rows = [("Source voltage  V  (volts)", "10", AMBER), ("Resistance  R  (Ω)", "100", PINK),
                ("Inductance  L  (mH)", "10", CYAN), ("Capacitance  C  (µF)", "10", GREEN),
                ("Starting frequency  f  (Hz)", "500", VIOLET)]
        self.entries = []
        for i, (txt, default, col) in enumerate(rows):
            tk.Label(card, text=txt, font=(FONT, 13, "bold"), bg=CARD, fg=col, anchor="w",
                     width=28).grid(row=i, column=0, pady=7, sticky="w")
            e = make_entry(card, col)
            e.insert(0, default)
            e.grid(row=i, column=1, padx=(20, 0), pady=7, ipady=4)
            self.entries.append(e)
        tk.Label(card, text="Circuit type", font=(FONT, 13, "bold"), bg=CARD, fg=TEXT,
                 anchor="w", width=28).grid(row=5, column=0, pady=7, sticky="w")
        self.kind = tk.StringVar(value="Series")
        rb = tk.Frame(card, bg=CARD)
        rb.grid(row=5, column=1, padx=(20, 0))
        for txt in ("Series", "Parallel"):
            tk.Radiobutton(rb, text=txt, value=txt, variable=self.kind, bg=CARD, fg="white",
                           selectcolor="#312e81", activebackground=CARD, activeforeground="white",
                           font=(FONT, 12, "bold")).pack(side="left", padx=6)
        btns = tk.Frame(self, bg=BG)
        btns.pack(pady=6)
        make_button(btns, "←  Back", lambda: self.app.show("welcome"), "#475569").pack(side="left", padx=10)
        make_button(btns, "Continue  →", self.go, GREEN, fg=BG).pack(side="left", padx=10)

    def go(self):
        try:
            V, R, L, C, f = (float(e.get()) for e in self.entries)
            if min(V, R, L, C, f) <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Invalid input", "Please enter positive numbers in all the boxes.")
            return
        c = self.app.circuit
        c.V, c.R, c.L, c.C, c.kind = V, R, L * 1e-3, C * 1e-6, self.kind.get()
        if not self.app.freqs:
            self.app.freqs.append(f)
        self.app.show("menu")


OFFSETS = [(14, 18), (14, -36), (-120, 18), (-120, -36)]


def fmt(v, unit):
    return f"{v:.4g} {unit}".strip()


def style_axes(ax):
    ax.set_facecolor(CARD)
    for s in ax.spines.values():
        s.set_color("#475569")
    ax.tick_params(colors=TEXT, labelsize=10)
    ax.grid(True, color="#334155", alpha=0.6, ls="--")


def annotate_point(ax, x, y, text, i=0):
    dx, dy = OFFSETS[i % 4]
    ax.annotate(text, xy=(x, y), xytext=(dx, dy), textcoords="offset points", color="white",
                fontsize=10, fontweight="bold",
                bbox=dict(boxstyle="round,pad=0.35", fc="#312e81", ec=AMBER, lw=1.3),
                arrowprops=dict(arrowstyle="-|>", color=AMBER, lw=1.5), zorder=6)


